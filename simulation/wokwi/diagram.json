{
  "version": 1,
  "author": "Smart Water Tank Controller",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "chip-a02yyuw",
      "id": "sensor",
      "top": 30,
      "left": -250,
      "attrs": { "simulate": "1", "distance": "1300", "fillRate": "15", "useRate": "4", "dryRun": "0", "sensorFault": "0" }
    },
    { "type": "wokwi-relay-module", "id": "k1", "top": -40, "left": 200, "attrs": { "transistor": "npn" } },
    { "type": "wokwi-slide-switch", "id": "s1_on", "top": 110, "left": 230, "attrs": { "value": "1", "bounce": "0" } },
    { "type": "wokwi-slide-switch", "id": "s1_man", "top": 110, "left": 320, "attrs": { "value": "", "bounce": "0" } },
    { "type": "wokwi-led", "id": "km", "top": 200, "left": 400, "attrs": { "color": "blue", "label": "KM" } },
    { "type": "wokwi-led", "id": "h1", "top": 200, "left": 460, "attrs": { "color": "green", "label": "H1" } },
    { "type": "wokwi-resistor", "id": "r_km", "top": 290, "left": 380, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_h1", "top": 290, "left": 440, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "sensor:VCC", "esp:3V3", "red", [] ],
    [ "sensor:GND", "esp:GND.1", "black", [] ],
    [ "sensor:TX", "esp:RX2", "green", [] ],
    [ "sensor:RX", "esp:GND.1", "blue", [] ],

    [ "k1:VCC", "esp:VIN", "red", [] ],
    [ "k1:GND", "esp:GND.2", "black", [] ],
    [ "k1:IN", "esp:D32", "orange", [] ],

    [ "esp:3V3", "s1_on:2", "brown", [] ],
    [ "s1_on:3", "s1_man:2", "brown", [] ],
    [ "s1_man:1", "k1:COM", "brown", [] ],
    [ "k1:NO", "km:A", "brown", [] ],
    [ "s1_man:3", "km:A", "brown", [] ],
    [ "km:A", "h1:A", "brown", [] ],
    [ "km:A", "sensor:PUMP", "purple", [] ],
    [ "km:C", "r_km:1", "black", [] ],
    [ "h1:C", "r_h1:1", "black", [] ],
    [ "r_km:2", "esp:GND.1", "black", [] ],
    [ "r_h1:2", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
